<Application x:Class="PCInsight.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#152238"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E7EDF7"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,10,8"/><Setter Property="Background" Value="#69E2C2"/><Setter Property="Foreground" Value="#102338"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="#23334C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#41536C"/></Style>
 </Application.Resources>
</Application>
