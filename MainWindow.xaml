<Window x:Class="PCInsight.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PC Insight" Width="1120" Height="850" MinWidth="860" MinHeight="650" Background="#0B1424" FontFamily="Segoe UI" FontSize="14">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32">
  <TextBlock Text="PC INSIGHT   /   LOCAL DIAGNOSTICS" Foreground="#69E2C2" FontWeight="Bold" FontSize="13"/>
  <TextBlock Text="Find what’s slowing you down." FontSize="34" FontWeight="SemiBold" Margin="0,12,0,8"/>
  <TextBlock Text="Measure first. Understand the evidence. Upgrade with confidence." Foreground="#A6B6CE" Margin="0,0,0,24"/>
  <WrapPanel>
   <Button x:Name="ScanButton" Content="Check my PC" Click="Scan_Click"/>
   <Button x:Name="BenchButton" Content="Run short tests" Click="Bench_Click"/>
   <Button x:Name="WatchButton" Content="Watch slow activity · 30s" Click="Watch_Click"/>
   <Button x:Name="CancelButton" Content="Stop" Click="Cancel_Click" IsEnabled="False" Background="#EDB6A6"/>
   <Button Content="Export report" Click="Export_Click" Background="#B8C7E0"/>
  </WrapPanel>
  <TextBlock x:Name="Status" Text="Ready. Start with Check my PC. No administrator access required." Foreground="#69E2C2" Margin="0,8,0,8"/>
  <ProgressBar x:Name="Progress" Height="3" Visibility="Collapsed" IsIndeterminate="True"/>
  <Border Background="{StaticResource Panel}" Padding="22" CornerRadius="12" Margin="0,20,0,14"><StackPanel>
   <TextBlock Text="01   YOUR BUILD" FontWeight="Bold" Foreground="#9DB0CF"/>
   <TextBlock x:Name="BuildText" Text="CPU · GPU · RAM · storage · motherboard" Margin="0,12,0,0" FontSize="16"/>
  </StackPanel></Border>
  <Border Background="{StaticResource Panel}" Padding="22" CornerRadius="12" Margin="0,0,0,14"><StackPanel>
   <TextBlock Text="02   PERFORMANCE &amp; EVIDENCE" FontWeight="Bold" Foreground="#9DB0CF"/>
   <TextBlock Text="While recording, switch to the game or app that feels slow. These tests are local diagnostics, not standardized benchmark scores." Foreground="#A6B6CE" Margin="0,10,0,10"/>
   <TextBlock x:Name="PerformanceText" Text="No measurements yet."/>
   <ItemsControl x:Name="Findings" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="#21324B" Padding="14" Margin="0,0,0,8" CornerRadius="6"><StackPanel>
     <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>
     <TextBlock Text="{Binding Evidence}" Margin="0,6,0,0"/>
     <TextBlock Text="{Binding Action}" Foreground="#69E2C2" Margin="0,6,0,0"/>
     <TextBlock Text="{Binding Confidence}" Foreground="#A6B6CE" Margin="0,6,0,0" FontSize="12"/>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
  <Border Background="{StaticResource Panel}" Padding="22" CornerRadius="12"><StackPanel>
   <TextBlock Text="03   UPGRADE SHORTLIST" FontWeight="Bold" Foreground="#9DB0CF"/>
   <TextBlock Text="Ranked by measured pressure and budget. Offers must include recent prices and exact motherboard support evidence. Physical fit, BIOS and power still need confirmation." Foreground="#A6B6CE" Margin="0,10,0,12"/>
   <WrapPanel><TextBlock Text="Budget (USD)" VerticalAlignment="Center" Margin="0,0,10,8"/><TextBox x:Name="Budget" Text="500" Width="100" Margin="0,0,12,8"/><Button Content="Load offer JSON" Click="Offers_Click"/><Button Content="Refresh feed" Click="Feed_Click"/><Button Content="Rank offers" Click="Rank_Click"/></WrapPanel>
   <TextBox x:Name="FeedUrl" ToolTip="HTTPS JSON price feed URL" Text=""/>
   <TextBlock Text="Optional HTTPS JSON feed URL above. No catalog configured by default; see README for the documented offer format." Foreground="#A6B6CE" FontSize="12" Margin="0,8,0,12"/>
   <TextBlock x:Name="OffersText" Text="Record a slow activity to establish upgrade priorities. No prices are fabricated."/>
  </StackPanel></Border>
  <TextBlock Text="PRIVATE BY DEFAULT   •   No telemetry uploads   •   Reports stay on your PC" Foreground="#8094B4" FontSize="12" Margin="0,22,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
